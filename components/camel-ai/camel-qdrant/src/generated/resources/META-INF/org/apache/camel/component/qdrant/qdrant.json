  "bodyTypes": {
    "producerIn": { "carriers": [ "pojo", "list", "null" ], "byOption": [ { "option": "action", "value": "CREATE_COLLECTION", "carriers": [ "pojo" ], "javaType": "io.qdrant.client.grpc.Collections.VectorParams" }, { "option": "action", "value": "DELETE_COLLECTION", "carriers": [ "any" ] }, { "option": "action", "value": "UPSERT", "carriers": [ "pojo", "list" ] }, { "option": "action", "value": "RETRIEVE", "carriers": [ "pojo", "list" ] }, { "option": "action", "value": "DELETE", "carriers": [ "pojo" ] }, { "option": "action", "value": "SIMILARITY_SEARCH", "carriers": [ "list", "pojo" ] }, { "option": "action", "value": "COLLECTION_INFO", "carriers": [ "any" ] } ], "description": "By the action in the action option or the CamelQdrantAction header: a VectorParams for CREATE_COLLECTION, a PointStruct or a List of them for UPSERT, a PointId or a List of them for RETRIEVE, a PointsSelector, PointId, Filter or Condition for DELETE, and the query vector as a List of Float, a float array or a PointStruct for SIMILARITY_SEARCH. DELETE_COLLECTION and COLLECTION_INFO do not read the body. Another body fails, such as a number as the id (use PointIdFactory.id) or a List of Double. The qdrant:embeddings data type transformer builds the PointStruct from the output of langchain4j-embeddings" },
    "producerOut": { "carriers": [ "list", "pojo", "unchanged" ], "byOption": [ { "option": "action", "value": "CREATE_COLLECTION", "carriers": [ "unchanged" ] }, { "option": "action", "value": "DELETE_COLLECTION", "carriers": [ "unchanged" ] }, { "option": "action", "value": "UPSERT", "carriers": [ "unchanged" ] }, { "option": "action", "value": "RETRIEVE", "carriers": [ "list" ], "javaType": "java.util.List<io.qdrant.client.grpc.Points.RetrievedPoint>" }, { "option": "action", "value": "DELETE", "carriers": [ "unchanged" ] }, { "option": "action", "value": "SIMILARITY_SEARCH", "carriers": [ "list" ], "javaType": "java.util.List<io.qdrant.client.grpc.Points.ScoredPoint>" }, { "option": "action", "value": "COLLECTION_INFO", "carriers": [ "pojo" ], "javaType": "io.qdrant.client.grpc.Collections.CollectionInfo" } ], "description": "By the action: a List of RetrievedPoint for RETRIEVE, a List of ScoredPoint for SIMILARITY_SEARCH and a CollectionInfo for COLLECTION_INFO. The other actions keep the body, UPSERT and DELETE with the operation id and status in headers" }
