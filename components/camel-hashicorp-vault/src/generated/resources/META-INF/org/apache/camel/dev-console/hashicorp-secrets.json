{
  "console": {
    "kind": "console",
    "group": "camel",
    "name": "hashicorp-secrets",
    "title": "HashiCorp Secrets",
    "description": "HashiCorp Vault Secrets",
    "deprecated": false,
    "readOnly": true,
    "javaType": "org.apache.camel.component.hashicorp.vault.SecretsDevConsole",
    "groupId": "org.apache.camel",
    "artifactId": "camel-hashicorp-vault",
    "version": "4.23.0-SNAPSHOT"
  },
  "response": {
    "type": "object",
    "properties": {
      "host": {
        "type": "string",
        "description": "The Vault host (only present when configured)"
      },
      "port": {
        "type": "string",
        "description": "The Vault port (only present when configured)"
      },
      "scheme": {
        "type": "string",
        "description": "The Vault scheme (only present when configured)"
      },
      "login": {
        "type": "string",
        "description": "The login method (only present when configured)"
      }
    }
  }
}

