<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd
    ">

  <routeConfigurationContext id="myConf" xmlns="http://camel.apache.org/schema/spring">
    <routeConfiguration>
      <onCompletion>
        <to uri="mock:global"/>
      </onCompletion>
    </routeConfiguration>
    <routeConfiguration id="myconfig">
      <onCompletion>
        <to uri="mock:named"/>
      </onCompletion>
    </routeConfiguration>
  </routeConfigurationContext>

  <camelContext xmlns="http://camel.apache.org/schema/spring">
    <jmxAgent id="jmx" disabled="true"/>

    <routeConfigurationContextRef ref="myConf"/>

    <!-- both routes use the global configuration -->
    <route>
      <from uri="direct:global"/>
      <to uri="direct:globalSub"/>
    </route>
    <route>
      <from uri="direct:globalSub"/>
      <to uri="mock:result"/>
    </route>

    <!-- both routes opt in to the named configuration -->
    <route routeConfigurationId="myconfig">
      <from uri="direct:named"/>
      <to uri="direct:namedSub"/>
    </route>
    <route routeConfigurationId="myconfig">
      <from uri="direct:namedSub"/>
      <to uri="mock:result"/>
    </route>

  </camelContext>

</beans>
