<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.camel</groupId>
        <artifactId>components</artifactId>
        <version>4.24.0-SNAPSHOT</version>
    </parent>

    <artifactId>camel-ibm-parent</artifactId>
    <packaging>pom</packaging>
    <name>Camel :: IBM :: Parent</name>
    <description>Camel IBM parent</description>

    <modules>
        <module>camel-ibm-cos</module>
        <module>camel-ibm-secrets-manager</module>
        <module>camel-ibm-watson-language</module>
        <module>camel-ibm-watson-discovery</module>
        <module>camel-ibm-watson-text-to-speech</module>
        <module>camel-ibm-watson-speech-to-text</module>
        <module>camel-ibm-watsonx-ai</module>
        <module>camel-ibm-watsonx-data</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- The IBM SDKs bring an older com.ibm.cloud:sdk-core (9.20.0 for Watson 16.2.0, 9.18.4 for
                 watsonx.data 0.9.0) that uses the Gson internal class $Gson$Types, which Gson 2.13.0 renamed
                 to GsonTypes: with the Gson of camel-parent, parsing a response whose model has dynamic
                 properties fails with NoClassDefFoundError. sdk-core 9.23.1 and later use GsonTypes; 9.24.x
                 is the last line on OkHttp 4, which the IBM SDKs are built with (9.25.0 moved to OkHttp 5).
                 Each module that uses sdk-core also declares it, so that applications get this version too. -->
            <dependency>
                <groupId>com.ibm.cloud</groupId>
                <artifactId>sdk-core</artifactId>
                <version>${ibm-sdk-core-version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
