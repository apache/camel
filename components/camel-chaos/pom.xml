<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.camel</groupId>
        <artifactId>components</artifactId>
        <version>4.24.0-SNAPSHOT</version>
    </parent>

    <artifactId>camel-chaos</artifactId>
    <packaging>jar</packaging>

    <name>Camel :: Chaos</name>
    <description>Turn on faults in a running Camel application during development, and report how the routes cope</description>

    <properties>
        <firstVersion>4.24.0</firstVersion>
        <label>tooling,testing</label>
        <title>Chaos</title>
        <supportLevel>Preview</supportLevel>
        <!-- the DST test loads the byte code agent of camel-test-dst when the JVM starts (see test-dst.adoc) -->
        <camel.surefire.fork.additional-vmargs>"-javaagent:${net.bytebuddy:byte-buddy-agent:jar}"</camel.surefire.fork.additional-vmargs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-util-json</artifactId>
        </dependency>
        <dependency>
            <!-- the route definition of a route that a lifecycle rule removes, to add it back -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core-model</artifactId>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-test-junit6</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-main</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-file</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- a stub that stands in for another component, as camel run with stubs serves it -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-stub</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the deterministic simulation test that runs chaos rules in virtual time (dst package) -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-test-dst</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the exception of the HTTP components, for the error fault with status= -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-http-base</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the exception of camel-netty-http, for the error fault with status= -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-netty-http</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- a circuit breaker runs its steps on a copy of the exchange, for the effect of a fault in it -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-resilience4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- chaos and the exchange sanitizer together on the same routes -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-sanitizer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility-version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- the model of the chaos rules (META-INF/org/apache/camel/chaos/chaos-model.json), from ChaosModel -->
                <groupId>org.apache.camel</groupId>
                <artifactId>camel-package-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate-chaos-model</id>
                        <goals>
                            <goal>generate-chaos-model</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- sets the property net.bytebuddy:byte-buddy-agent:jar to the path of the agent of the DST test -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dst-agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
