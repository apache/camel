{
  "console": {
    "kind": "console",
    "group": "camel",
    "name": "kubernetes-secrets",
    "title": "Kubernetes Secrets",
    "description": "Kubernetes Cluster Secrets",
    "deprecated": false,
    "readOnly": true,
    "javaType": "org.apache.camel.component.kubernetes.secrets.vault.SecretsDevConsole",
    "groupId": "org.apache.camel",
    "artifactId": "camel-kubernetes",
    "version": "4.23.0-SNAPSHOT"
  },
  "response": {
    "type": "object",
    "properties": {
      "masterUrl": {
        "type": "string",
        "description": "The Kubernetes master URL (only present when configured)"
      },
      "login": {
        "type": "string",
        "description": "The login method (only present when configured)"
      },
      "refreshEnabled": {
        "type": "boolean",
        "description": "Whether secret refresh is enabled (only present when configured)"
      },
      "startCheckTimestamp": {
        "type": "integer",
        "description": "Epoch time in milliseconds the refresh task started (only present when known)"
      },
      "secrets": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The secret name"
            }
          }
        },
        "description": "The secrets in use"
      }
    }
  }
}

