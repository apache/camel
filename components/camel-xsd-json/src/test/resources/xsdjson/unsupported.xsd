<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:u="urn:unsupported"
           targetNamespace="urn:unsupported" elementFormDefault="qualified">

  <xs:element name="mixed">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element name="b" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="open">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:string"/>
        <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="untyped"/>

  <xs:element name="holder">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="u:shape"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="shape" type="u:Shape" abstract="true"/>
  <xs:element name="circle" type="u:Shape" substitutionGroup="u:shape"/>
  <xs:complexType name="Shape">
    <xs:sequence>
      <xs:element name="size" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Animal" abstract="true">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="pet" type="u:Animal"/>

  <!-- an attribute and a child element with the same name -->
  <xs:element name="clash">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:string"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- two children with the same local name -->
  <xs:element name="twice">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="a" type="xs:string"/>
        <xs:element name="b" type="xs:string"/>
        <xs:element name="a" type="xs:int"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
