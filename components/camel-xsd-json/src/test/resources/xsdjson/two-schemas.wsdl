<!-- two inline schemas: the messages schema imports the types schema by namespace only -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:t="urn:types" xmlns:m="urn:messages" targetNamespace="urn:messages">
  <types>
    <xs:schema targetNamespace="urn:messages" elementFormDefault="qualified">
      <xs:import namespace="urn:types"/>
      <xs:element name="lookup">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="item" type="t:Item"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
    <xs:schema targetNamespace="urn:types">
      <xs:complexType name="Item">
        <xs:sequence>
          <xs:element name="code" type="xs:string"/>
          <xs:element name="count" type="xs:unsignedInt"/>
        </xs:sequence>
      </xs:complexType>
    </xs:schema>
  </types>
</definitions>
