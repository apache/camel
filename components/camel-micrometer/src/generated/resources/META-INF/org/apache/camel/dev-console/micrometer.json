              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "value"
          ]
        },
        "description": "Only present when there are any gauges"
      },
      "timers": {
        "type": "array",
        "items": {
