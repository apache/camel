            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "count": {
              "type": "integer"
            },
            "mean": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
