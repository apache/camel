<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.camel</groupId>
        <artifactId>components</artifactId>
        <version>4.24.0-SNAPSHOT</version>
    </parent>

    <artifactId>camel-sanitizer</artifactId>
    <packaging>jar</packaging>

    <name>Camel :: Sanitizer</name>
    <description>Check during development and tests that the processors of the routes keep the contract of AsyncProcessor, and report where they break it</description>

    <properties>
        <firstVersion>4.24.0</firstVersion>
        <label>tooling,testing</label>
        <title>Sanitizer</title>
        <supportLevel>Preview</supportLevel>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-support</artifactId>
        </dependency>
        <dependency>
            <!-- the definition of a step, to name the processor of a user in a report -->
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core-model</artifactId>
        </dependency>
        <dependency>
            <!-- for the JUnit extension (org.apache.camel.sanitizer.junit) only; the API of JUnit 5, which JUnit 6 keeps -->
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit-jupiter-version}</version>
            <optional>true</optional>
        </dependency>
        <!-- no tests here: the tests of camel-sanitizer are in camel-core, which uses it in test scope -->
    </dependencies>
</project>
