{
  "console": {
    "kind": "console",
    "group": "camel",
    "name": "kafka",
    "title": "Kafka",
    "description": "Apache Kafka",
    "deprecated": false,
    "readOnly": true,
    "javaType": "org.apache.camel.component.kafka.KafkaDevConsole",
    "groupId": "org.apache.camel",
    "artifactId": "camel-kafka",
    "version": "4.23.0-SNAPSHOT"
  },
  "options": {
    "committed": {
      "index": 0,
      "kind": "option",
      "displayName": "Committed",
      "group": "query",
      "label": "query",
      "required": false,
      "type": "boolean",
      "javaType": "java.lang.Boolean",
      "deprecated": false,
      "autowired": false,
      "secret": false,
      "defaultValue": false,
      "description": "Whether to include committed offset (sync operation to Kafka broker)"
    }
  },
  "response": {
    "type": "object",
    "properties": {
      "kafkaConsumers": {
        "type": "array",
