                      "type": "object",
                      "properties": {
                        "topic": {
                          "type": "string",
                          "description": "The topic"
                        },
                        "partition": {
                          "type": "integer",
                          "description": "The partition"
                        },
                        "offset": {
                          "type": "integer",
                          "description": "The committed offset"
                        },
                        "epoch": {
                          "type": "integer",
                          "description": "The epoch"
                        }
                      },
                      "required": [
                        "partition",
                        "offset",
                        "epoch"
                      ]
                    },
                    "description": "The committed offsets (only present when requested and there are any)"
