<!-- Options the Java DSL takes as arguments of the step, or in another form than name("value") (CAMEL-25157) -->
<routes xmlns="http://camel.apache.org/schema/xml-io">
  <route id="options" startupOrder="5" errorHandlerRef="myErrorHandler">
    <from uri="direct:options"/>
    <inputType urn="json:Order"/>
    <convertBodyTo type="java.lang.String" charset="UTF-8"/>
    <convertBodyTo type="java.lang.Integer" mandatory="false"/>
    <convertHeaderTo name="a" toName="b" type="java.lang.String"/>
    <removeHeaders pattern="Beer*" excludePattern="BeerKeep"/>
    <removeProperties pattern="f*" excludePattern="fiu"/>
    <setHeaders>
      <setHeader name="h1"><simple>${body}</simple></setHeader>
      <setHeader name="h2"><constant>two</constant></setHeader>
    </setHeaders>
    <setVariables>
      <setVariable name="v1"><constant>one</constant></setVariable>
    </setVariables>
    <to uri="direct:send" variableSend="v1"/>
    <toD uri="mock:${header.foo}" ignoreInvalidEndpoint="true"/>
    <log message="hi" logName="my.log" loggingLevel="WARN"/>
    <sample messageFrequency="10"/>
    <recipientList stopOnException="true" ignoreInvalidEndpoints="true"><header>to</header></recipientList>
    <to uri="mock:end"/>
  </route>
  <route id="blocks">
    <from uri="direct:blocks"/>
    <onCompletion mode="BeforeConsumer">
      <to uri="mock:done"/>
    </onCompletion>
    <loop doWhile="true">
      <simple>${body} != 'done'</simple>
      <to uri="mock:loop"/>
    </loop>
    <aggregate aggregationStrategy="myStrategy">
      <correlationExpression><header>id</header></correlationExpression>
      <completionSizeExpression><header>size</header></completionSizeExpression>
      <to uri="mock:aggregated"/>
    </aggregate>
    <enrich aggregationStrategy="myStrategy"><constant>direct:resource</constant></enrich>
    <split>
      <tokenize token=","/>
      <to uri="mock:part"/>
    </split>
    <loadBalance>
      <weightedLoadBalancer distributionRatio="4,2,1"/>
      <to uri="mock:x"/>
      <to uri="mock:y"/>
      <to uri="mock:z"/>
    </loadBalance>
    <policy ref="myPolicy">
      <to uri="mock:policy"/>
    </policy>
    <to uri="mock:after"/>
  </route>
  <route id="rollback">
    <from uri="direct:rollback"/>
    <rollback markRollbackOnly="true"/>
  </route>
</routes>
